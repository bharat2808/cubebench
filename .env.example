# Run commands from the CubeBench project root. Shell environment takes precedence.
PORT=4310
HOST=127.0.0.1
CUBEBENCH_DB=.data/cubebench.sqlite
CUBEBENCH_SIGNING_KEY=.data/signing-key.pem
CUBEBENCH_PUBLIC_URL=http://127.0.0.1:4310
# Optional exact hostnames/origins for a TLS reverse proxy:
# CUBEBENCH_ALLOWED_HOSTS=cubebench.example.com
# CUBEBENCH_ALLOWED_ORIGINS=https://cubebench.example.com
# Hosted OAuth resource server (external issuer; not provider API keys):
# CUBEBENCH_OAUTH_ISSUER=https://auth.example.com/
# CUBEBENCH_OAUTH_JWKS=https://auth.example.com/.well-known/jwks.json
# CUBEBENCH_TRUSTED_RUNNERS=trusted-runner-subject
# stdio gateway only:
# CUBEBENCH_URL=http://127.0.0.1:4310
# CUBEBENCH_TOKEN=<CubeBench credential from auth:issue>
# Optional project-local browser install:
# PLAYWRIGHT_BROWSERS_PATH=.cache/playwright
