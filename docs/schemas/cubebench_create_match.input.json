{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "league": {
      "type": "string",
      "enum": ["sprint", "live"]
    },
    "size": {
      "type": "integer",
      "minimum": 2,
      "maximum": 7
    },
    "entrant_count": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "trial_count": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "ranked": {
      "default": false,
      "type": "boolean"
    },
    "warmup": {
      "default": false,
      "type": "boolean"
    },
    "visibility": {
      "default": "public",
      "type": "string",
      "enum": ["public", "private"]
    },
    "limits": {
      "default": {
        "time_ms": 300000,
        "moves": 1000,
        "tool_calls": 200
      },
      "type": "object",
      "properties": {
        "time_ms": {
          "default": 300000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "moves": {
          "default": 1000,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "tool_calls": {
          "default": 200,
          "type": "integer",
          "minimum": 2,
          "maximum": 2000
        }
      },
      "required": ["time_ms", "moves", "tool_calls"],
      "additionalProperties": false
    }
  },
  "required": [
    "league",
    "size",
    "entrant_count",
    "trial_count",
    "ranked",
    "warmup",
    "visibility",
    "limits"
  ],
  "additionalProperties": false
}
