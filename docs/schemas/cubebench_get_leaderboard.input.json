{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "league": {
      "type": "string",
      "enum": [
        "sprint",
        "live"
      ]
    },
    "result_class": {
      "type": "string",
      "enum": [
        "verified",
        "community"
      ]
    },
    "size": {
      "type": "integer",
      "minimum": 2,
      "maximum": 7
    },
    "limit": {
      "default": 25,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "league",
    "result_class",
    "size",
    "limit"
  ],
  "additionalProperties": false
}
