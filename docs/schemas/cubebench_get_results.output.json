{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "result_id": {
                "type": "string"
              },
              "match_id": {
                "type": "string"
              },
              "round_id": {
                "type": "string"
              },
              "participant_id": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              },
              "league": {
                "type": "string",
                "enum": ["sprint", "live"]
              },
              "classification": {
                "type": "string",
                "enum": ["ranked", "community", "practice"]
              },
              "verification": {
                "type": "string",
                "enum": ["verified", "community"]
              },
              "submitter_identity": {
                "type": "string"
              },
              "runner_identity": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "size": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "seed": {
                "type": "string"
              },
              "scramble": {
                "type": "string"
              },
              "initial_state": {
                "type": "object",
                "properties": {
                  "size": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 20
                  },
                  "facelets": {
                    "type": "object",
                    "properties": {
                      "U": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "R": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "F": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "D": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "L": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "B": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      }
                    },
                    "required": ["U", "R", "F", "D", "L", "B"],
                    "additionalProperties": false
                  }
                },
                "required": ["size", "facelets"],
                "additionalProperties": false
              },
              "final_state": {
                "type": "object",
                "properties": {
                  "size": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 20
                  },
                  "facelets": {
                    "type": "object",
                    "properties": {
                      "U": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "R": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "F": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "D": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "L": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      },
                      "B": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["U", "R", "F", "D", "L", "B"]
                        }
                      }
                    },
                    "required": ["U", "R", "F", "D", "L", "B"],
                    "additionalProperties": false
                  }
                },
                "required": ["size", "facelets"],
                "additionalProperties": false
              },
              "versions": {
                "type": "object",
                "properties": {
                  "schema": {
                    "type": "string"
                  },
                  "engine": {
                    "type": "string"
                  },
                  "notation": {
                    "type": "string"
                  },
                  "generator": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string"
                  }
                },
                "required": ["schema", "engine", "notation", "generator", "prompt", "format"],
                "additionalProperties": false
              },
              "attempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "call_index": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "sequence": {
                      "type": "string"
                    },
                    "accepted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rejected": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "failure": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "solved",
                            "unsolved_submission",
                            "invalid_notation",
                            "illegal_move_for_cube_size",
                            "malformed_tool_arguments",
                            "move_limit_exceeded",
                            "tool_call_limit_exceeded",
                            "timeout",
                            "abandoned",
                            "disconnected",
                            "unauthorized",
                            "internal_server_error"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["call_index", "sequence", "accepted", "rejected", "failure"],
                  "additionalProperties": false
                }
              },
              "timeline": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "tool": {
                      "type": "string"
                    },
                    "received_at": {
                      "type": "string"
                    },
                    "elapsed_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "outcome": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "index",
                    "tool",
                    "received_at",
                    "elapsed_ms",
                    "duration_ms",
                    "outcome"
                  ],
                  "additionalProperties": false
                }
              },
              "started_at": {
                "type": "string"
              },
              "finished_at": {
                "type": "string"
              },
              "elapsed_ms": {
                "type": "number",
                "minimum": 0
              },
              "time_to_first_move_ms": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "move_count": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "tool_call_count": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "success": {
                "type": "boolean"
              },
              "failure": {
                "type": "string",
                "enum": [
                  "solved",
                  "unsolved_submission",
                  "invalid_notation",
                  "illegal_move_for_cube_size",
                  "malformed_tool_arguments",
                  "move_limit_exceeded",
                  "tool_call_limit_exceeded",
                  "timeout",
                  "abandoned",
                  "disconnected",
                  "unauthorized",
                  "internal_server_error"
                ]
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "display_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "claimed_provider": {
                    "default": "unspecified",
                    "type": "string",
                    "maxLength": 80
                  },
                  "claimed_model": {
                    "default": "unspecified",
                    "type": "string",
                    "maxLength": 160
                  },
                  "model_snapshot": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 160
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "harness_name": {
                    "default": "unspecified",
                    "type": "string",
                    "maxLength": 80
                  },
                  "harness_version": {
                    "default": "unspecified",
                    "type": "string",
                    "maxLength": 80
                  },
                  "reasoning_effort": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 80
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "system_prompt_hash": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mcp_client_identity": {
                    "default": "unspecified",
                    "type": "string",
                    "maxLength": 160
                  }
                },
                "required": [
                  "display_name",
                  "claimed_provider",
                  "claimed_model",
                  "model_snapshot",
                  "harness_name",
                  "harness_version",
                  "reasoning_effort",
                  "system_prompt_hash",
                  "mcp_client_identity"
                ],
                "additionalProperties": false
              },
              "trusted_usage": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "input_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "output_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "cost_usd": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": ["input_tokens", "output_tokens", "cost_usd"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "event_hash": {
                "type": "string"
              },
              "signature": {
                "type": "string"
              },
              "signing_key_id": {
                "type": "string"
              }
            },
            "required": [
              "result_id",
              "match_id",
              "round_id",
              "participant_id",
              "run_id",
              "league",
              "classification",
              "verification",
              "submitter_identity",
              "runner_identity",
              "size",
              "seed",
              "scramble",
              "initial_state",
              "final_state",
              "versions",
              "attempts",
              "timeline",
              "started_at",
              "finished_at",
              "elapsed_ms",
              "time_to_first_move_ms",
              "move_count",
              "tool_call_count",
              "success",
              "failure",
              "metadata",
              "trusted_usage",
              "event_hash",
              "signature",
              "signing_key_id"
            ],
            "additionalProperties": false
          }
        },
        "public_key": {
          "type": "string"
        },
        "export_version": {
          "type": "string",
          "const": "1.0.0"
        }
      },
      "required": ["ok", "results", "public_key", "export_version"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "solved",
                "unsolved_submission",
                "invalid_notation",
                "illegal_move_for_cube_size",
                "malformed_tool_arguments",
                "move_limit_exceeded",
                "tool_call_limit_exceeded",
                "timeout",
                "abandoned",
                "disconnected",
                "unauthorized",
                "internal_server_error"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["category", "message"],
          "additionalProperties": false
        }
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    }
  ]
}
