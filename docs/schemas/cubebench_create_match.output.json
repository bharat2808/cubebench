{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "match_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "participant_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "tokens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "round_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "participant_token": {
                      "type": "string",
                      "minLength": 20,
                      "maxLength": 256
                    },
                    "expires_at": {
                      "type": "string"
                    }
                  },
                  "required": ["round_id", "participant_token", "expires_at"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["participant_id", "tokens"],
            "additionalProperties": false
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "index": {
                "type": "number"
              },
              "execution_order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              }
            },
            "required": ["round_id", "index", "execution_order"],
            "additionalProperties": false
          }
        }
      },
      "required": ["ok", "match_id", "participants", "rounds"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "solved",
                "unsolved_submission",
                "invalid_notation",
                "illegal_move_for_cube_size",
                "malformed_tool_arguments",
                "move_limit_exceeded",
                "tool_call_limit_exceeded",
                "timeout",
                "abandoned",
                "disconnected",
                "unauthorized",
                "internal_server_error"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["category", "message"],
          "additionalProperties": false
        }
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    }
  ]
}
