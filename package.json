{
  "name": "cubebench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx packages/mcp-server/src/main.ts --dev",
    "start": "node dist/server/main.js",
    "mcp:stdio": "tsx packages/mcp-server/src/stdio.ts",
    "db:migrate": "tsx packages/persistence/src/cli.ts migrate",
    "auth:issue": "tsx packages/persistence/src/cli.ts token",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build --config packages/web/vite.config.ts && tsup packages/mcp-server/src/main.ts packages/mcp-server/src/stdio.ts --format esm --platform node --out-dir dist/server --external vite",
    "schemas": "tsx scripts/export-schemas.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
